# --- database (libSQL / Turso) ---
# Local dev uses a SQLite file; production points at Turso (libsql://...).
DATABASE_URL=file:local.db
# DATABASE_AUTH_TOKEN= # set for Turso, leave unset for local file

# --- auth (better-auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- GitHub OAuth (required) ---
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: ${BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- app ---
# Base URL used to build ping URLs shown to users.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret the cron scheduler sends as a Bearer token to the evaluator.
CRON_SECRET=
